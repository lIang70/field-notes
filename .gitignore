# Whitelist mode: ignore everything, then allow explicitly
*

# ── Git config ──
!.gitignore

# ── Root documentation ──
!README.md
!LICENSE

# ── Notes ──
!ai
!ai/**
!go/
!go/**
!os/
!os/**
!rust
!rust/**

# ── Tooling ──
!Makefile
!scripts
!scripts/**

# ── Published site: config, hooks, templates, CSS, build script ──
!web
!web/**
!.github
!.github/**

# ── Never commit (must stay last: later patterns win) ──
web/.build/
web/.venv/
web/mkdocs.generated.yml
__pycache__/
*.pyc
